#!/usr/bin/env bash
# Two jobs: (1) catch .claude/settings.json.example drifting from the live file,
# (2) check whether org-internal context is left in the example.
#
# The example is produced by hand (jq 'del(.autoMode.environment)'), so it goes
# stale silently — and this repo is public. Trust this check, not the filter.

set -uo pipefail
example=".claude/settings.json.example"
live="$HOME/.claude/settings.json"

git diff --cached --name-only | rg -q "^${example}$" || exit 0
command -v jq &>/dev/null || exit 0

if jq -e '.autoMode.environment' "$example" >/dev/null 2>&1; then
  echo "pre-commit: $example contains autoMode.environment — org-internal context." >&2
  echo "  jq 'del(.autoMode.environment)' \"$live\" > $example" >&2
  exit 1
fi

if [[ -r "$live" ]] && ! diff -q <(jq -S 'del(.autoMode.environment)' "$live" 2>/dev/null) \
                                 <(jq -S . "$example" 2>/dev/null) >/dev/null 2>&1; then
  echo "pre-commit: $example differs from the live settings — it may be stale." >&2
  echo "  refresh: jq 'del(.autoMode.environment)' \"$live\" > $example" >&2
  echo "  see the diff: diff <(jq -S 'del(.autoMode.environment)' \"$live\") <(jq -S . $example)" >&2
  exit 1
fi
