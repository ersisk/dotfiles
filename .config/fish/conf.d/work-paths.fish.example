# Real work directory paths - EXAMPLE file.
#
# Setup: copy this file to work-paths.fish and fill in the paths for your own
# machine. The real file is in .gitignore; it is kept out of the repo so internal
# project names never land in it.
#
#   cp work-paths.fish.example ~/.config/fish/conf.d/work-paths.fish
#
# sesh.toml and the tmux configs depend on these variables; without the file the
# work sessions do not open (everything else keeps working).

set -gx WORK_ROOT ~/workspace/example
set -gx WORK_MAIN $WORK_ROOT/main-project
set -gx WORK_BIN $WORK_ROOT/bin
set -gx WORK_NOTIF ~/workspace/example-notif
set -gx WORK_LIB ~/workspace/example-lib
set -gx WORK_TRANSLATE ~/workspace/example-translate
set -gx WORK_ORG ExampleOrg
set -gx WORK_MAIN_REPO main-project
set -gx WORK_TELI_REPO other-repo
set -gx WORK_TELI $WORK_ROOT/other-repo

# For the log_search container path (optional; unset means the container is skipped)
set -gx GTC_CONTAINER your-app-container

# The jira-cli token; jira-to-branch reads the issue title from the API with it.
# Deliberately without a WORK_ prefix: load-work-env.sh copies only WORK_* variables
# into tmux's global environment, where the token would be visible to every session.
# set -gx JIRA_API_TOKEN xxxxx
