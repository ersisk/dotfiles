#!/usr/bin/env bash
# Tek kaynak: hem fish `shs` hem tmux prefix+T buraya gelir.
# tmux icindeyken fzf-tmux popup, disinda duz fzf kullanilir.
if [ -n "$TMUX" ]; then
  picker=(fzf-tmux -p 100%,100% --reverse --border-label ' sesh ')
else
  picker=(fzf --no-border --list-border --input-border --header-border \
    --color 'list-border:6,input-border:3,preview-border:4,header-bg:-1,header-border:6')
fi

# ctrl-w icin repo koku: tmux'ta aktif pane, disinda cwd; ikisi de git degilse WORK_MAIN.
if [ -n "$TMUX" ]; then
  repo_dir=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null)
else
  repo_dir=$PWD
fi
git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1 || repo_dir=${WORK_MAIN:-$PWD}

selected=$(
  sesh list --icons --hide-duplicates | "${picker[@]}" \
    --ansi \
    --no-sort --prompt '⚡  ' \
    --header '  ^a all ^t tmux ^g configs ^x zoxide ^w worktree ^d tmux kill ^f find' \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list --icons)' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list -t --icons)' \
    --bind 'ctrl-g:change-prompt(⚙️  )+reload(sesh list -c --icons)' \
    --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list -z --icons)' \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 2 -t d -E .Trash . ~)' \
    --bind "ctrl-w:change-prompt(🌿  )+reload(git -C '$repo_dir' worktree list --porcelain | grep ^worktree | cut -d' ' -f2 | tail -n +2)" \
    --bind 'ctrl-d:execute(tmux kill-session -t {2..})+change-prompt(⚡  )+reload(sesh list --icons)' \
    --preview-window 'right:70%' \
    --preview 'sesh preview {}'
)

# Esc/ctrl-c ile cikista bos string ile sesh connect cagirmayi engelle.
[ -z "$selected" ] && exit 0
sesh connect "$selected"
