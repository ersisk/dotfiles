#!/usr/bin/env bash
#
# ai-oneshot — prompt from stdin, answer to stdout. One shot, no conversation.
#
# There are two backends, and which one wins depends on input size, measured:
#
#   task                        ollama (qwen3, warm)    claude -p (haiku)
#   Jira title translation      0.9s                    13.3s
#   541-line diff               45.2s + broken format   14-16s
#
# The local model wins outright on a small prompt; on a big diff its prefill is
# expensive on an M3 Pro and it cannot hold the format on long input. So the
# choice is left to the caller: AI_ONESHOT_BACKEND=claude goes straight remote.
#
# Docker Desktop's Model Runner squats on 11434 and returns an empty model
# list; hence the port list is tried in order and the host that ACTUALLY has
# the model is used, not the first one that answers.

set -uo pipefail

usage() {
  cat >&2 <<'USAGE_EOF'
ai-oneshot — one-shot question, one answer

USAGE
  ai-oneshot [-c] [question...]
  <command> | ai-oneshot [-c] [instruction...]

  An argument is the question; with a pipe too, the piped content is the data:
    git diff | ai "summarise this change"

OPTIONS
  -c, --claude   skip the local model, go straight to claude -p
  -h, --help     this help

ENVIRONMENT
  AI_ONESHOT_BACKEND         auto (default) | ollama | claude
  AI_ONESHOT_OLLAMA_MODEL    default: qwen3:latest
  AI_ONESHOT_CLAUDE_MODEL    default: claude-haiku-4-5-20251001
  AI_ONESHOT_OLLAMA_HOSTS    addresses tried in order
USAGE_EOF
}

BACKEND="${AI_ONESHOT_BACKEND:-auto}"
OLLAMA_MODEL="${AI_ONESHOT_OLLAMA_MODEL:-qwen3:latest}"
CLAUDE_MODEL="${AI_ONESHOT_CLAUDE_MODEL:-claude-haiku-4-5-20251001}"
HOSTS="${AI_ONESHOT_OLLAMA_HOSTS:-http://127.0.0.1:11435 http://127.0.0.1:11434}"
# Ollama's default is 5 minutes: the model drops out of memory between calls and
# reloading alone adds ~8s (10s cold, 1.6s warm — measured).
KEEP_ALIVE="${AI_ONESHOT_KEEP_ALIVE:-30m}"

while (( $# )); do
  case "$1" in
    -c|--claude) BACKEND=claude; shift ;;
    -h|--help)   usage; exit 0 ;;
    --)          shift; break ;;
    *)           break ;;
  esac
done

# Argument = instruction, pipe = data. With both, the instruction goes first;
# with only a pipe (how the calling scripts do it) behaviour is unchanged.
if (( $# )); then
  prompt="$*"
  [[ -t 0 ]] || prompt="$prompt"$'\n\n'"$(cat)"
else
  prompt=$(cat)
fi
[[ -n "$prompt" ]] || { usage; exit 1; }

# Stream only while the output goes to a terminal. The calling scripts (aimsg,
# aipr, jira-to-branch) capture the output and need it buffered, because an
# empty answer is only recognisable after seeing all of it to fall back.
streaming() { [[ -t 1 ]]; }

run_claude() {
  command -v claude &>/dev/null || { echo "ai-oneshot: claude not found" >&2; return 1; }
  if streaming && command -v jq &>/dev/null; then
    # thinking_delta arrives too, only text_delta is printed.
    printf '%s' "$prompt" | claude -p --model "$CLAUDE_MODEL" \
        --output-format stream-json --include-partial-messages --verbose 2>/dev/null \
      | jq --unbuffered -j 'select(.type == "stream_event")
                            | .event.delta? // empty
                            | select(.type == "text_delta")
                            | .text'
    echo
    return 0
  fi
  printf '%s' "$prompt" | claude -p --model "$CLAUDE_MODEL" 2>/dev/null
}

run_ollama() {
  command -v jq &>/dev/null || return 1
  local host out
  for host in $HOSTS; do
    curl -sf -m 1 "$host/api/tags" 2>/dev/null \
      | jq -e --arg m "$OLLAMA_MODEL" '.models // [] | any(.name == $m)' >/dev/null 2>&1 || continue
    # think:false — otherwise thinking models like qwen3 put a <think> block before the answer.
    if streaming; then
      # Also written to a marker file via tee so an empty answer can be caught;
      # the stream to the screen is untouched.
      local mark; mark=$(mktemp)
      jq -nc --arg m "$OLLAMA_MODEL" --arg p "$prompt" --arg k "$KEEP_ALIVE" \
          '{model:$m, prompt:$p, stream:true, think:false, keep_alive:$k, options:{temperature:0.2}}' \
        | curl -sfN -m 180 "$host/api/generate" -d @- 2>/dev/null \
        | jq --unbuffered -j '.response // empty' \
        | tee "$mark"
      if [[ -s "$mark" ]]; then rm -f "$mark"; echo; return 0; fi
      rm -f "$mark"; continue
    fi
    out=$(jq -nc --arg m "$OLLAMA_MODEL" --arg p "$prompt" --arg k "$KEEP_ALIVE" \
            '{model:$m, prompt:$p, stream:false, think:false, keep_alive:$k, options:{temperature:0.2}}' \
          | curl -sf -m 180 "$host/api/generate" -d @- 2>/dev/null \
          | jq -r '.response // empty')
    [[ -n "$out" ]] || continue
    printf '%s\n' "$out"
    return 0
  done
  return 1
}

case "$BACKEND" in
  claude) run_claude ;;
  ollama) run_ollama ;;
  *)      run_ollama || run_claude ;;
esac
