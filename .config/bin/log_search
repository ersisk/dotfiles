#!/bin/bash

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  printf '\033[0mlog_search — pick and inspect project log files with fzf\n\n'
  printf '\033[1mUSAGE\033[0m\n'
  printf '  log_search [action] [file-prefix]\n\n'
  printf '\033[1mARGUMENTS\033[0m\n'
  printf '  action        skip the menu, pick the action directly (1-5)\n'
  printf '  file-prefix   use <log-dir>/<prefix>-<today>.log instead of fzf\n'
  printf '  -h, --help    this help\n\n'
  printf '\033[1mLOG SOURCE\033[0m\n'
  printf '  Tried in order: var/log, log, storage/logs (host).\n'
  printf '  If none exist and the container is up, the log directory inside the\n'
  printf '  container is used; the file is pulled to the host temporarily.\n'
  printf '  Container name comes from $GTC_CONTAINER; unset means the container is skipped.\n\n'
  printf '\033[1mACTIONS\033[0m\n'
  printf '  1 tail -f, 2 last 100000 lines, 3 nvim, 4 jlv, 5 sieve\n\n'
  printf '\033[1mEXAMPLES\033[0m\n'
  printf '  log_search              # pick the file with fzf, pick the action from the menu\n'
  printf '  log_search 1            # pick with fzf, tail -f directly\n'
  printf '  log_search 1 app        # follow <log-dir>/app-<today>.log\n'
  exit 0
fi

# Is fzf installed?
if ! command -v fzf &>/dev/null; then
  echo "fzf not found. Please install fzf."
  exit 1
fi

# Find the log directory: common paths on the host, fall back to the container.
CONTAINER="${GTC_CONTAINER:-}"
LOG_DIR=""
IN_CONTAINER=0
for d in var/log log storage/logs; do
  if [ -d "$d" ]; then
    LOG_DIR="$d"
    break
  fi
done

if [ -z "$LOG_DIR" ]; then
  # Look inside the container (logs may not be mounted on the host)
  if [ -n "$CONTAINER" ] && command -v docker &>/dev/null && docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$CONTAINER"; then
    for d in /data/project/log /data/project/var/log /var/log/nginx; do
      if docker exec "$CONTAINER" test -d "$d" 2>/dev/null; then
        LOG_DIR="$d"
        IN_CONTAINER=1
        break
      fi
    done
  fi
fi

if [ -z "$LOG_DIR" ]; then
  echo "log_search: no log directory found (var/log, log, storage/logs${CONTAINER:+ or inside $CONTAINER})" >&2
  exit 1
fi

# If a second parameter is given, use it as the file name (file-date.log)
if [ -n "${2:-}" ]; then
  current_date=$(date +%Y-%m-%d)
  selected_file="$LOG_DIR/$2-$current_date.log"
  if [ "$IN_CONTAINER" -eq 1 ]; then
    docker exec "$CONTAINER" test -f "$selected_file" 2>/dev/null || {
      echo "Error: file not found: $CONTAINER:$selected_file" >&2
      exit 1
    }
  elif [ ! -f "$selected_file" ]; then
    echo "Error: file not found: $selected_file" >&2
    exit 1
  fi
else
  # Pick the file with fzf (newest first)
  if [ "$IN_CONTAINER" -eq 1 ]; then
    selected_file=$(docker exec "$CONTAINER" sh -c "ls -t '$LOG_DIR'/*.log 2>/dev/null" \
      | fzf --reverse --header "$CONTAINER:$LOG_DIR")
  else
    selected_file=$(find "$LOG_DIR" -type f | fzf --reverse --header "$LOG_DIR")
  fi
fi

# Pull the container file to the host: nvim/jlv/sieve/hl are not in the container.
# tail -f is a live follow, so it is streamed straight from the container instead.
local_file="$selected_file"
if [ "$IN_CONTAINER" -eq 1 ] && [ -n "$selected_file" ] && [ "${1:-}" != "1" ]; then
  local_file="$(mktemp -t logsearch)"
  trap 'rm -f "$local_file"' EXIT
  docker exec "$CONTAINER" cat "$selected_file" > "$local_file" 2>/dev/null || {
    echo "Error: could not pull file: $selected_file" >&2
    exit 1
  }
fi

# If a file was selected, show the action menu
if [ -n "$selected_file" ]; then
  echo "Selected file: $selected_file"
  # Use the parameter if given (e.g. ./script.sh 1), otherwise show the menu
  if [ -n "$1" ]; then
    choice="$1"
  else
    echo "Pick an action:"
    echo "1) Follow the file (tail -f)"
    echo "2) Show the last 100000 lines (tail -n 100000)"
    echo "3) Edit the file (nvim)"
    echo "4) jlv"
    echo "5) sieve"
    read -r choice
  fi

  case $choice in
  1)
    echo "Following file: $selected_file"
    if [ "$IN_CONTAINER" -eq 1 ]; then
      docker exec "$CONTAINER" tail -f "$selected_file" | hl -P
    else
      tail -f "$selected_file" | hl -P
    fi
    ;;
  2)
    echo "Last 100000 lines of the file:"
    tail -n 100000 "$local_file" | hl -P
    ;;
  3)
    echo "Editing file: $selected_file"
    nvim "$local_file"
    ;;
  4)
    echo "Viewing with jlv: $selected_file"
    jlv "$local_file"
    ;;
  5)
    echo "Viewing with sieve: $selected_file"
    sieve "$local_file"
    ;;
  *)
    echo "Invalid choice, exiting."
    ;;
  esac

else
  echo "No file selected."
fi
