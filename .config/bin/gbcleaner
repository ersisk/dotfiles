#!/bin/bash
#
# Git Branch Cleaner
# Lists branches merged into the selected branch with fzf, deletes the
# picked ones, and loops until none are left or ESC is pressed.
#

set -euo pipefail

# ── Colors ───────────────────────────────────────────────
RED='\033[1;31m'
GREEN='\033[1;32m'
BLUE='\033[1;34m'
YELLOW='\033[1;33m'
DIM='\033[2m'
RESET='\033[0m'

# ── Checks ───────────────────────────────────────────────
if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo -e "${RED}Error: not a git repository.${RESET}"
    exit 1
fi

if ! command -v fzf &>/dev/null; then
    echo -e "${RED}Error: fzf is not installed. brew install fzf${RESET}"
    exit 1
fi

# ── Protected branches (never listed) ────────────────────
PROTECTED_BRANCHES="main|master|develop|staging|release"

# ── Target branch selection ──────────────────────────────
select_target_branch() {
    local branches
    branches=$(git branch -a --format='%(refname:short)' | grep -v 'HEAD' | sort -u)

    echo -e "${BLUE}Which branch's merged branches do you want to clean up?${RESET}" >&2
    local target
    target=$(echo "$branches" | fzf \
        --height=40% \
        --border=rounded \
        --prompt="Target branch › " \
        --header="ESC: Quit" \
        --no-multi)

    if [[ -z "$target" ]]; then
        echo -e "${YELLOW}Cancelled.${RESET}" >&2
        exit 0
    fi

    echo "$target"
}

# ── Fetch merged branches (protected ones excluded) ──────
get_merged_branches() {
    local target="$1"
    local branches

    # Local branches
    local local_branches
    local_branches=$(git branch --merged "$target" --format='%(refname:short)' \
        | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
        | grep -vxE "${PROTECTED_BRANCHES}" \
        | grep -vx "${target}" || true)

    # Remote branches (origin/HEAD and protected ones excluded)
    local remote_branches
    remote_branches=$(git branch -r --merged "$target" --format='%(refname:short)' \
        | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
        | grep -v 'HEAD' \
        | grep -vE "^origin/(${PROTECTED_BRANCHES})$" \
        | grep -vE "^origin/${target}$" || true)

    branches=$(printf '%s\n%s' "$local_branches" "$remote_branches" \
        | sed '/^$/d' | sort -u)

    [[ -z "$branches" ]] && return

    while IFS= read -r branch; do
        local author
        author=$(git log -1 --format='%an' "$branch" 2>/dev/null || echo "?")
        local tag="local"
        [[ "$branch" == origin/* ]] && tag="remote"
        printf '%-40s  %-8s  %s\n' "$branch" "[$tag]" "$author"
    done <<< "$branches"
}

# ── Delete loop ──────────────────────────────────────────
cleanup_loop() {
    local target="$1"
    local deleted=0

    while true; do
        local merged
        merged=$(get_merged_branches "$target")

        if [[ -z "$merged" ]]; then
            echo ""
            echo -e "${GREEN}Clean! No branches merged into '${target}' left to delete.${RESET}"
            break
        fi

        local count
        count=$(echo "$merged" | wc -l | tr -d ' ')

        echo ""
        echo -e "${BLUE}── ${count} branches merged into '${target}' ──${RESET}"
        echo -e "${DIM}   ESC: Exit loop  |  ENTER: Delete selected  |  TAB: Multi-select${RESET}"

        local selected
        selected=$(echo "$merged" | fzf \
            --height=50% \
            --border=rounded \
            --prompt="Branch to delete › " \
            --header="Merged → ${target}  (${count} branches)" \
            --multi \
            --nth=1 \
            --with-nth=1.. \
            --preview="git log --oneline --graph -10 {1}" \
            --preview-window=right:50%:wrap \
            | awk '{print $1}') || true

        # ESC or empty selection → quit
        if [[ -z "$selected" ]]; then
            echo -e "${YELLOW}Loop ended.${RESET}"
            break
        fi

        # Delete the selected ones
        while IFS= read -r branch; do
            [[ -z "$branch" ]] && continue

            if [[ "$branch" == origin/* ]]; then
                # Remote branch: origin/xyz → push --delete origin xyz
                local remote_name="${branch#origin/}"
                if git push origin --delete "$remote_name" 2>/dev/null; then
                    echo -e "  ${RED}✗${RESET} ${branch} ${GREEN}remote deleted${RESET}"
                    ((deleted++))
                else
                    echo -e "  ${YELLOW}⚠${RESET} ${branch} remote delete failed"
                fi
            else
                # Local branch
                if git branch -d "$branch" 2>/dev/null; then
                    echo -e "  ${RED}✗${RESET} ${branch} ${GREEN}deleted${RESET}"
                    ((deleted++))
                else
                    echo -e "  ${YELLOW}⚠${RESET} ${branch} delete failed (force may be needed)"
                    read -rp "    Apply force delete (-D)? [y/N] " confirm
                    if [[ "$confirm" =~ ^[yY]$ ]]; then
                        git branch -D "$branch"
                        echo -e "  ${RED}✗${RESET} ${branch} ${GREEN}force deleted${RESET}"
                        ((deleted++))
                    fi
                fi
            fi
        done <<< "$selected"
    done

    echo ""
    echo -e "${GREEN}Deleted ${deleted} branches in total.${RESET}"
}

# ── Main flow ────────────────────────────────────────────
main() {
    echo -e "${BLUE}"
    echo "  ╔══════════════════════════════╗"
    echo "  ║    Git Branch Cleaner 🧹     ║"
    echo "  ╚══════════════════════════════╝"
    echo -e "${RESET}"
    echo -e "${DIM}  Protected branches: ${PROTECTED_BRANCHES//|/, }${RESET}"
    echo ""

    local target
    if [[ $# -gt 0 ]]; then
        target="$1"
        # Verify the branch exists
        if ! git rev-parse --verify "$target" &>/dev/null; then
            echo -e "${RED}Error: branch '${target}' not found.${RESET}"
            exit 1
        fi
    else
        target=$(select_target_branch)
    fi

    echo -e "${GREEN}Target: ${target}${RESET}"

    cleanup_loop "$target"
}

main "$@"
