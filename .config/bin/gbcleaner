#!/bin/bash
#
# Git Branch Cleaner
# Seçilen branch'e merge olmuş branch'leri fzf ile listeler,
# seçileni siler, hiç kalmayana veya ESC'e basılana kadar döngüde kalır.
#

set -euo pipefail

# ── Renkler ──────────────────────────────────────────────
RED='\033[1;31m'
GREEN='\033[1;32m'
BLUE='\033[1;34m'
YELLOW='\033[1;33m'
DIM='\033[2m'
RESET='\033[0m'

# ── Kontroller ───────────────────────────────────────────
if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo -e "${RED}Hata: Git reposu değil.${RESET}"
    exit 1
fi

if ! command -v fzf &>/dev/null; then
    echo -e "${RED}Hata: fzf yüklü değil. brew install fzf${RESET}"
    exit 1
fi

# ── Korunacak branch'ler (bunlar asla listelenmez) ───────
PROTECTED_BRANCHES="main|master|develop|staging|release"

# ── Hedef branch seçimi ─────────────────────────────────
select_target_branch() {
    local branches
    branches=$(git branch -a --format='%(refname:short)' | grep -v 'HEAD' | sort -u)

    echo -e "${BLUE}Hangi branch'e merge olmuş branch'leri temizlemek istiyorsun?${RESET}" >&2
    local target
    target=$(echo "$branches" | fzf \
        --height=40% \
        --border=rounded \
        --prompt="Hedef branch › " \
        --header="ESC: Çıkış" \
        --no-multi)

    if [[ -z "$target" ]]; then
        echo -e "${YELLOW}İptal edildi.${RESET}" >&2
        exit 0
    fi

    echo "$target"
}

# ── Merge olmuş branch'leri getir (korunanlar hariç) ────
get_merged_branches() {
    local target="$1"
    local branches

    # Local branch'ler
    local local_branches
    local_branches=$(git branch --merged "$target" --format='%(refname:short)' \
        | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
        | grep -vxE "${PROTECTED_BRANCHES}" \
        | grep -vx "${target}" || true)

    # Remote branch'ler (origin/HEAD ve korunanlar hariç)
    local remote_branches
    remote_branches=$(git branch -r --merged "$target" --format='%(refname:short)' \
        | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
        | grep -v 'HEAD' \
        | grep -vE "^origin/(${PROTECTED_BRANCHES})$" \
        | grep -vE "^origin/${target}$" || true)

    branches=$(printf '%s\n%s' "$local_branches" "$remote_branches" \
        | sed '/^$/d' | sort -u)

    [[ -z "$branches" ]] && return

    while IFS= read -r branch; do
        local author
        author=$(git log -1 --format='%an' "$branch" 2>/dev/null || echo "?")
        local tag="local"
        [[ "$branch" == origin/* ]] && tag="remote"
        printf '%-40s  %-8s  %s\n' "$branch" "[$tag]" "$author"
    done <<< "$branches"
}

# ── Silme döngüsü ───────────────────────────────────────
cleanup_loop() {
    local target="$1"
    local deleted=0

    while true; do
        local merged
        merged=$(get_merged_branches "$target")

        if [[ -z "$merged" ]]; then
            echo ""
            echo -e "${GREEN}Temiz! '${target}' branch'ine merge olmuş silinecek branch kalmadı.${RESET}"
            break
        fi

        local count
        count=$(echo "$merged" | wc -l | tr -d ' ')

        echo ""
        echo -e "${BLUE}── '${target}' branch'ine merge olmuş ${count} branch ──${RESET}"
        echo -e "${DIM}   ESC: Döngüden çık  |  ENTER: Seçileni sil  |  TAB: Çoklu seç${RESET}"

        local selected
        selected=$(echo "$merged" | fzf \
            --height=50% \
            --border=rounded \
            --prompt="Silinecek branch › " \
            --header="Merge edilmiş → ${target}  (${count} branch)" \
            --multi \
            --nth=1 \
            --with-nth=1.. \
            --preview="git log --oneline --graph -10 {1}" \
            --preview-window=right:50%:wrap \
            | awk '{print $1}') || true

        # ESC veya boş seçim → çık
        if [[ -z "$selected" ]]; then
            echo -e "${YELLOW}Döngü sonlandırıldı.${RESET}"
            break
        fi

        # Seçilenleri sil
        while IFS= read -r branch; do
            [[ -z "$branch" ]] && continue

            if [[ "$branch" == origin/* ]]; then
                # Remote branch: origin/xyz → push --delete origin xyz
                local remote_name="${branch#origin/}"
                if git push origin --delete "$remote_name" 2>/dev/null; then
                    echo -e "  ${RED}✗${RESET} ${branch} ${GREEN}remote silindi${RESET}"
                    ((deleted++))
                else
                    echo -e "  ${YELLOW}⚠${RESET} ${branch} remote silinemedi"
                fi
            else
                # Local branch
                if git branch -d "$branch" 2>/dev/null; then
                    echo -e "  ${RED}✗${RESET} ${branch} ${GREEN}silindi${RESET}"
                    ((deleted++))
                else
                    echo -e "  ${YELLOW}⚠${RESET} ${branch} silinemedi (force gerekebilir)"
                    read -rp "    Force delete (-D) uygulansın mı? [e/H] " confirm
                    if [[ "$confirm" =~ ^[eE]$ ]]; then
                        git branch -D "$branch"
                        echo -e "  ${RED}✗${RESET} ${branch} ${GREEN}force silindi${RESET}"
                        ((deleted++))
                    fi
                fi
            fi
        done <<< "$selected"
    done

    echo ""
    echo -e "${GREEN}Toplam ${deleted} branch silindi.${RESET}"
}

# ── Ana Akış ─────────────────────────────────────────────
main() {
    echo -e "${BLUE}"
    echo "  ╔══════════════════════════════╗"
    echo "  ║    Git Branch Cleaner 🧹     ║"
    echo "  ╚══════════════════════════════╝"
    echo -e "${RESET}"
    echo -e "${DIM}  Korunan branch'ler: ${PROTECTED_BRANCHES//|/, }${RESET}"
    echo ""

    local target
    if [[ $# -gt 0 ]]; then
        target="$1"
        # Branch'in var olduğunu doğrula
        if ! git rev-parse --verify "$target" &>/dev/null; then
            echo -e "${RED}Hata: '${target}' branch'i bulunamadı.${RESET}"
            exit 1
        fi
    else
        target=$(select_target_branch)
    fi

    echo -e "${GREEN}Hedef: ${target}${RESET}"

    cleanup_loop "$target"
}

main "$@"
