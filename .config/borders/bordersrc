#!/bin/bash
# Kanagawa: crystalBlue when active, sumiInk4 when inactive.
# Every gap in aerospace is 0 - this border is the only marker of the focused window.
# hidpi: so the border comes out sharp on a Retina display.

options=(
	style=round
	width=5.0
	hidpi=on
	active_color=0xff7e9cd8
	inactive_color=0xff363646
)

borders "${options[@]}"
