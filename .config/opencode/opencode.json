{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llmroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llm-route",
      "options": {
        "baseURL": "https://llmgateway.teknasyon.com/v1",
        "apiKey": "{file:~/.config/opencode/llmroute.key}"
      },
      "models": {
        "Orchestrator": {},
        "Explorer": {},
        "Planner": {},
        "Executer": {},
        "Reviewer": {}
      }
    }
  },
  "mcp": {
    "qmd": {
      "type": "local",
      "command": ["qmd", "mcp"],
      "enabled": true
    }
  }
}
