.config/zed/prompts/*
.config/nvim/lazy-lock.json
.config/envim/lazy-lock.json
.config/tmux/plugins
.config/yazi/flavors/

# ~/.claude runtime state. settings.json BILEREK takip edilmiyor: Claude Code
# oraya autoMode.environment yaziyor — organizasyon adi, private repo adlari,
# CI secret isimleri, deploy hedefleri. Bu repo public. Sadece ornek versiyonlanir.
.claude/*
!.claude/settings.json.example

# Is yerine ait gercek yollar - repoda tutulmaz
.config/fish/conf.d/work-paths.fish

# Derlenmis binary'ler - repoda tutulmaz (biri x86_64, Rosetta ile calisiyor)
.config/bin/aws-ssh
.config/bin/merged-branches

# Derlenmis menubar binary - kaynak .local/share/claude-menubar/ altinda
.local/bin/claude-menubar

# Derlenmis OCR binary - kaynak .local/share/screen-ocr/ altinda
.local/bin/screen-ocr

# Raycast'in kendi state'i - API token'i ve kurulu extension'lar, repoda tutulmaz
.config/raycast/config.json
.config/raycast/extensions/
.config/raycast/ai/
