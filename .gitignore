.config/zed/prompts/*
.config/nvim/lazy-lock.json
.config/envim/lazy-lock.json
.config/tmux/plugins
.config/yazi/flavors/

# ~/.claude runtime state. settings.json is DELIBERATELY untracked: Claude Code
# writes autoMode.environment into it — organisation name, private repo names,
# CI secret names, deploy targets. This repo is public. Only the example is versioned.
.claude/*
!.claude/settings.json.example

# Real work paths - not kept in the repo
.config/fish/conf.d/work-paths.fish

# Compiled binaries - not kept in the repo (one is x86_64, running under Rosetta)
.config/bin/aws-ssh
.config/bin/merged-branches

# Compiled menubar binary - the source is under .local/share/claude-menubar/
.local/bin/claude-menubar

# Compiled OCR binary - the source is under .local/share/screen-ocr/
.local/bin/screen-ocr

# Compiled PiP defocus binary - the source is under .local/share/zen-pip-defocus/
.local/bin/zen-pip-defocus

# jira-cli config - Jira server address and login e-mail, and this repo is public
.config/.jira/

# Raycast's own state - API token and installed extensions, not kept in the repo
.config/raycast/config.json
.config/raycast/extensions/
.config/raycast/ai/

# macOS Finder metadata
.DS_Store

# python bytecode cache (appears if keys-panel.py is imported)
__pycache__/
*.pyc
