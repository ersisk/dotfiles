#!/usr/bin/env bash
# claude-tmux-notify
# Claude Code hook script: records per-session state for the claude-menubar app
# (and shows a tmux status-line message when inside tmux) when Claude stops,
# needs input, or finishes a long-running bash command / background task.
#
# Install:
#   mkdir -p ~/.local/bin
#   cp claude-tmux-notify ~/.local/bin/claude-tmux-notify
#   chmod +x ~/.local/bin/claude-tmux-notify
#
# How it works:
#   SessionStart / SessionEnd  → register / drop the session (silent)
#   UserPromptSubmit           → mark working (silent)
#   Stop / Notification        → always notify
#   PreToolUse  (Bash)         → stash start timestamp, mark working
#   PostToolUse (Bash)         → notify only if elapsed >= threshold
#   PreToolUse  (Task)         → stash run_in_background flag, mark bg-running
#   SubagentStop               → notify only if the subagent was background
#
# Every event writes the session's state to $MENUBAR_DIR, which the menu bar app
# watches. The tmux status line is used only where it can actually be seen:
#   visible (kitty focused, active pane of active window) → nothing, you're watching
#   kitty focused, pane in another session/window/pane    → tmux status line
#   kitty backgrounded, or the pane's session detached    → menu bar only

set -euo pipefail

# --- Configuration -----------------------------------------------------------
# Minimum seconds a bash command must run before triggering a notification.
NOTIFY_THRESHOLD="${CLAUDE_NOTIFY_THRESHOLD:-10}"
# Scratch directory for timestamps and flags between Pre/Post hooks.
STATE_DIR="${TMPDIR:-/tmp}/claude-tmux-notify"
# tmux display duration in milliseconds.
DISPLAY_MS=5000
# Set to 0 to disable the semantic window-name state prefix (icon glyph).
WINDOW_STATE="${CLAUDE_WINDOW_STATE:-1}"
# Session state files consumed by the claude-menubar app. Persistent, not $TMPDIR:
# launchd hands the app a different TMPDIR than an interactive shell.
MENUBAR_DIR="${CLAUDE_MENUBAR_STATE_DIR:-$HOME/.local/state/claude-menubar/sessions}"
# -----------------------------------------------------------------------------

# Read the hook payload from stdin
PAYLOAD=$(cat)

# --- Parse JSON payload ------------------------------------------------------
if command -v jq &>/dev/null; then
  # One jq call: running a jq per field ate a third of the hook's runtime
  # (8 processes, ~21ms), and this hook fires on every Bash/Task call.
  #
  # The separator is 0x1F, not a tab: IFS treats a tab as "whitespace", so runs of
  # tabs collapse into one and empty fields vanish - on a payload without tool_input
  # (a Notification, say) every field would shift. Newlines/tabs inside a field and
  # the separator itself are turned into spaces: a command or message carrying 0x1F
  # would shift the fields. All of it is only used for a single-line display.
  IFS=$'\x1f' read -r EVENT TOOL TOOL_CMD TOOL_DESC RUN_BG SESSION_ID CWD TRANSCRIPT MESSAGE < <(
    jq -r '[
      .hook_event_name // "Unknown",
      .tool_name // "",
      .tool_input.command // "",
      .tool_input.description // "",
      .tool_input.run_in_background // false,
      .session_id // "",
      .cwd // "",
      .transcript_path // "",
      .message // ""
    ] | map(tostring | gsub("[\n\r\t\u001f]"; " ")) | join("\u001f")' <<< "$PAYLOAD" 2>/dev/null
  ) || true
  # If the parse failed outright there is nothing to write: rather than producing a
  # fake record with an "unknown" project, exit quietly.
  [[ -n "$EVENT" ]] || exit 0
else
  EVENT=$(echo "$PAYLOAD" | grep -o '"hook_event_name":"[^"]*"' | head -1 | sed 's/.*:"\(.*\)"/\1/')
  TRANSCRIPT=""
  TOOL=$(echo "$PAYLOAD" | grep -o '"tool_name":"[^"]*"' | head -1 | sed 's/.*:"\(.*\)"/\1/')
  TOOL_CMD=""
  TOOL_DESC=""
  RUN_BG="false"
  SESSION_ID=""
  MESSAGE=""
  CWD=$(echo "$PAYLOAD" | grep -o '"cwd":"[^"]*"' | head -1 | sed 's/.*:"\(.*\)"/\1/')
fi

PROJECT=$(basename "${CWD:-unknown}")
TARGET="${TMUX_PANE:-%0}"
# Unique key per session+pane (safe for parallel sessions).
KEY="${SESSION_ID:-default}_${TMUX_PANE:-term}"

mkdir -p "$STATE_DIR"

# --- Helpers -----------------------------------------------------------------
short_str() {
  local s="$1" max="${2:-40}"
  if [[ ${#s} -gt $max ]]; then
    echo "${s:0:$(( max - 3 ))}..."
  else
    echo "$s"
  fi
}

# Escape a value for a JSON string literal (jq-less fallback path only).
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/ }"
  s="${s//$'\r'/ }"
  s="${s//$'\t'/ }"
  s="${s//$'\x1f'/ }"
  printf '%s' "$s"
}

# Returns 0 if the kitty app is currently frontmost on macOS, 1 otherwise.
# Uses lsappinfo (fast, no TCC prompt) — falls back to "not focused" on error.
is_kitty_focused() {
  command -v lsappinfo &>/dev/null || return 1
  local front_info front_name
  front_info=$(lsappinfo info -only name "$(lsappinfo front)" 2>/dev/null) || return 1
  # Output looks like: "LSDisplayName"="kitty"
  front_name=$(printf '%s' "$front_info" | sed -n 's/.*"LSDisplayName"="\([^"]*\)".*/\1/p')
  [[ "$front_name" == "kitty" ]]
}

# Is the target pane on screen right now? True only when it is the active pane of
# the active window of a session some client is currently displaying.
#
# Note the deliberate use of #{session_attached} rather than a client lookup: a
# session with no attached client is one the user has switched away from, so its
# pane is not on screen — but it is still reachable in a keystroke, so it is NOT
# treated as unreachable (see DISPLAY_CLIENT below).
# Queried once per hook run; empty outside tmux. The pane's own session and window
# ride along in the same call — tmux_context and the menubar state file both need
# them, and one display-message is three fewer process spawns per hook.
# Tab is a safe separator here, unlike in the payload parse above: none of these four
# fields can come back empty, so there are never two delimiters in a row to collapse.
TARGET_VIS=""
TMUX_SESS=""
TMUX_WIN=""
TMUX_TTY=""
if [[ -n "${TMUX:-}" ]] && command -v tmux &>/dev/null; then
  IFS=$'\t' read -r TARGET_VIS TMUX_SESS TMUX_WIN TMUX_TTY < <(
    tmux display-message -p -t "$TARGET" \
      $'#{pane_active}#{window_active}#{?#{session_attached},1,0}\t#S\t#I\t#{pane_tty}' 2>/dev/null
  ) || true
fi

# Returns 0 when the target pane is what the user is actually looking at: the
# active pane of the active window of a session that is currently displayed.
# Returns 1 outside tmux — there is no "elsewhere" to be, the terminal is the view.
is_target_visible() {
  [[ "$TARGET_VIS" == "111" ]]
}

# The client to route status-line messages to. `display-message -t <pane>` renders
# only on a client displaying that pane's session, so a pane in a switched-away
# session would print to nobody. Any attached client on this server is looking at
# the same terminal, so it is the right place to show the message — the styled
# line carries the pane's own session:window, which says where to go.
# Empty when no client is attached (nothing on screen; the menu bar carries it).
if [[ -n "${TMUX:-}" ]] && command -v tmux &>/dev/null; then
  DISPLAY_CLIENT=$(tmux list-clients -F '#{client_name}' 2>/dev/null | head -1) || DISPLAY_CLIENT=""
else
  DISPLAY_CLIENT=""
fi

# Bare tmux session:window for the target pane, e.g. "Home:2". Empty when unavailable.
# Reads the values captured above, so it describes Claude's pane rather than the
# currently-active one.
tmux_context() {
  [[ -n "$TMUX_SESS" ]] || return 0
  printf '%s:%s' "$TMUX_SESS" "$TMUX_WIN"
}

# State file the claude-menubar app reads for this session. Keyed by session id so
# a resumed session updates its own entry instead of leaving a stale twin behind;
# falls back to the pane key when the payload carries no id.
state_file() {
  local key="${SESSION_ID:-$KEY}"
  printf '%s/%s.json' "$MENUBAR_DIR" "${key//[^A-Za-z0-9._-]/_}"
}

# Replaces the state file atomically. The rename is what wakes the app's directory
# watcher, so writing into the final path directly would leave the icon stale.
# The recorded tmux coordinates are what claude-jump uses to focus this pane; the
# tty is how the app notices Claude died without a SessionEnd. One line per file,
# so claude-next.sh can parse it with bash alone, without spawning jq.
write_state() {
  local state="$1" detail="${2:-}" file tmp socket=""
  file=$(state_file)
  tmp="${file}.$$"
  [[ -n "${TMUX:-}" ]] && socket="${TMUX%%,*}"

  mkdir -p "$MENUBAR_DIR" 2>/dev/null || return 0

  if command -v jq &>/dev/null; then
    jq -nc \
      --arg session_id "$SESSION_ID" \
      --arg state "$state" \
      --arg project "$PROJECT" \
      --arg cwd "$CWD" \
      --arg detail "$detail" \
      --arg tmux_socket "$socket" \
      --arg tmux_session "$TMUX_SESS" \
      --arg tmux_window "$TMUX_WIN" \
      --arg tmux_pane "${TMUX_PANE:-}" \
      --arg tmux_tty "$TMUX_TTY" \
      --argjson updated_at "$(date +%s)" \
      '$ARGS.named' > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  else
    printf '{"session_id":"%s","state":"%s","project":"%s","cwd":"%s","detail":"%s","tmux_socket":"%s","tmux_session":"%s","tmux_window":"%s","tmux_pane":"%s","tmux_tty":"%s","updated_at":%s}\n' \
      "$(json_escape "$SESSION_ID")" "$state" "$(json_escape "$PROJECT")" \
      "$(json_escape "$CWD")" "$(json_escape "$detail")" "$(json_escape "$socket")" \
      "$(json_escape "$TMUX_SESS")" "$(json_escape "$TMUX_WIN")" \
      "$(json_escape "${TMUX_PANE:-}")" "$(json_escape "$TMUX_TTY")" "$(date +%s)" > "$tmp" 2>/dev/null \
      || { rm -f "$tmp"; return 0; }
  fi

  mv -f "$tmp" "$file" 2>/dev/null || rm -f "$tmp"
}

remove_state() {
  rm -f "$(state_file)" 2>/dev/null || true
}

# Kanagawa Wave palette — inline styling for tmux display-message.
KW_INK='#16161d'    # sumiInk0  — badge foreground
KW_INK4='#54546d'   # sumiInk4  — context segment background
KW_BG='#1f1f28'     # sumiInk3  — message background; must match message-style in tmux.conf
KW_WHITE='#dcd7ba'  # fujiWhite — message text
KW_GREEN='#98bb6c'  # springGreen
KW_ORANGE='#ff9e3b' # roninYellow
KW_BLUE='#7e9cd8'   # crystalBlue
KW_YELLOW='#e6c384' # carpYellow
KW_SEP=$'\ue0b0'    # powerline right-facing separator (needs a Nerd Font)

# Renders a powerline-styled tmux message:
#   <glyph BADGE> ▶ <session:window> ▶ <text>
# $1 accent colour, $2 glyph, $3 badge label, $4 message text.
# The context segment is dropped when tmux lookup yields nothing.
tmux_styled() {
  local accent="$1" glyph="$2" badge="$3" text="$4"
  local ctx out
  ctx=$(tmux_context)

  out="#[fg=${KW_INK},bg=${accent},bold] ${glyph} ${badge} "
  if [[ -n "$ctx" ]]; then
    out+="#[fg=${accent},bg=${KW_INK4},nobold]${KW_SEP}#[fg=${KW_WHITE},bg=${KW_INK4}] ${ctx} "
    out+="#[fg=${KW_INK4},bg=${KW_BG}]${KW_SEP}#[fg=${KW_WHITE},bg=${KW_BG}] ${text} "
  else
    out+="#[fg=${accent},bg=${KW_BG},nobold]${KW_SEP}#[fg=${KW_WHITE},bg=${KW_BG}] ${text} "
  fi
  printf '%s' "$out"
}

# Semantic per-window state, shown as an icon glyph prefixed onto the window name.
# Hybrid to coexist with tmux-nerd-font-window-name:
#   - automatic-rename ON  (plugin drives the name): store the glyph in the
#     per-window @claude_state option; tmux.conf's automatic-rename-format
#     prepends it, so the plugin's re-renames re-compose the glyph, not clobber it.
#   - automatic-rename OFF (Claude Code / manual owns the name): the format never
#     runs, so prepend the glyph directly onto #W, stripping any known prefix first
#     (idempotent — re-applying never stacks). Also keep @claude_state in sync so
#     the glyph reappears if auto-rename is later turned back on.
# Nerd Font state glyphs (not emoji, so they can be coloured with Kanagawa).
# If this list changes, ClaudeMenubar.swift (phaseByGlyph) has to change with it;
# claude-sesh.sh shows the glyph as is.
# @claude_state doubles as an "unacknowledged work" mark: claude-menubar clears the
# option once it sees you have looked at a finished session's pane.
STATE_GLYPHS='󰓦󰛐󱎫'
# The previous emoji state set: it may still be stuck in a window name, so it is
# kept defined here to be stripped on rename.
LEGACY_GLYPHS='🔨⚙👀⏳🏁✅'
# Note: 󰘦 / 󰚩 are permanent window icons the user set in utility.conf; they are
# not state glyphs and must never be stripped.

set_window_state() {
  [[ "$WINDOW_STATE" == "1" ]] || return 0
  [[ -n "${TMUX:-}" ]] && command -v tmux &>/dev/null || return 0

  local glyph
  case "$1" in
    working)    glyph='󰓦' ;;
    waiting)    glyph='󰛐' ;;
    bg-running) glyph='󱎫' ;;
    done-bg)    glyph='' ;;
    done)       glyph='' ;;
    idle)       glyph='' ;;
    *)          return 0 ;;
  esac

  if [[ -n "$glyph" ]]; then
    tmux set-option -w -t "$TARGET" @claude_state "$glyph" 2>/dev/null || true
  else
    tmux set-option -uw -t "$TARGET" @claude_state 2>/dev/null || true
    tmux set-option -uw -t "$TARGET" @claude_last 2>/dev/null || true
  fi

  local autoren
  autoren=$(tmux display-message -p -t "$TARGET" '#{automatic-rename}' 2>/dev/null) || return 0
  [[ "$autoren" == "0" ]] || return 0

  local name stripped
  name=$(tmux display-message -p -t "$TARGET" '#W' 2>/dev/null) || return 0
  # Strip accumulated prefixes one by one: on windows carried over from the old
  # emoji set the name can layer up as "<new> <old> <older> Claude".
  # The nerd-font plugin may put its own spaces in front of the name, so the number
  # of spaces between glyph and name varies.
  stripped="$name"
  while [[ "$stripped" == [$STATE_GLYPHS$LEGACY_GLYPHS]* ]]; do
    stripped="${stripped#[$STATE_GLYPHS$LEGACY_GLYPHS]}"
    stripped="${stripped# }"
  done
  if [[ -n "$glyph" ]]; then
    tmux rename-window -t "$TARGET" "$glyph $stripped" 2>/dev/null || true
  else
    tmux rename-window -t "$TARGET" "$stripped" 2>/dev/null || true
  fi
}

# Writes the last user-visible message to LAST_MSG, and to the window option when
# tmux is around; claude-next.sh shows it in the preview and the menu bar in the
# row's description. With no transcript it is skipped quietly - the badge and glyph
# flow works independently of it.
LAST_MSG=""
set_last_message() {
  [[ -n "${TRANSCRIPT:-}" && -r "$TRANSCRIPT" ]] || return 0
  local msg
  msg=$(~/.config/tmux/claude-last-msg.sh "$TRANSCRIPT" 2>/dev/null) || return 0
  [[ -n "$msg" ]] || return 0
  LAST_MSG="$msg"
  [[ -n "${TMUX:-}" ]] && command -v tmux &>/dev/null || return 0
  tmux set-option -w -t "$TARGET" @claude_last "$msg" 2>/dev/null || true
}

# Shows the pre-rendered tmux_styled line, but only in the one case where it helps:
# kitty is focused and the pane is somewhere else. Watching the pane needs no
# message, and off screen the menu bar icon is the signal.
notify() {
  local tmux_line="$1"

  is_kitty_focused || return 0
  [[ -n "$DISPLAY_CLIENT" ]] || return 0
  is_target_visible && return 0

  # -c targets the live client, not the pane: a pane in a switched-away session
  # has no client of its own, so -t would render the message to nobody.
  tmux display-message -d "$DISPLAY_MS" -c "$DISPLAY_CLIENT" "$tmux_line" 2>/dev/null || true
}

# --- SessionStart / SessionEnd: menubar bookkeeping only ---------------------
# Nothing is written to stdout: for these events Claude Code would feed it back
# into the session as context.
if [[ "$EVENT" == "SessionStart" ]]; then
  write_state idle ""
  exit 0
fi

if [[ "$EVENT" == "SessionEnd" ]]; then
  set_window_state idle
  remove_state
  exit 0
fi

# --- UserPromptSubmit: Claude is busy before it reaches for any tool ----------
if [[ "$EVENT" == "UserPromptSubmit" ]]; then
  set_window_state working
  write_state working ""
  exit 0
fi

# --- PreToolUse: stash state, exit silently ----------------------------------
if [[ "$EVENT" == "PreToolUse" ]]; then

  if [[ "$TOOL" == "Task" && "$RUN_BG" == "true" ]]; then
    echo "$TOOL_DESC" > "${STATE_DIR}/bg_task_${KEY}"
    set_window_state bg-running
    write_state bg-running "$(short_str "${TOOL_DESC:-background task}" 60)"
    exit 0
  fi

  if [[ "$TOOL" == "Bash" ]]; then
    date +%s > "${STATE_DIR}/bash_${KEY}"
  fi

  set_window_state working
  write_state working "$(short_str "${TOOL_DESC:-$TOOL_CMD}" 60)"
  exit 0
fi

# --- PostToolUse (Bash): notify only if command was slow ---------------------
if [[ "$EVENT" == "PostToolUse" && "$TOOL" == "Bash" ]]; then
  TS_FILE="${STATE_DIR}/bash_${KEY}"

  if [[ -f "$TS_FILE" ]]; then
    START=$(cat "$TS_FILE")
    rm -f "$TS_FILE"
    NOW=$(date +%s)
    ELAPSED=$(( NOW - START ))

    if (( ELAPSED >= NOTIFY_THRESHOLD )); then
      SHORT=$(short_str "$TOOL_CMD")
      write_state working "✓ ${ELAPSED}s · ${SHORT}"
      notify "$(tmux_styled "$KW_YELLOW" '⚡' 'BASH' "${SHORT} · ${ELAPSED}s")"
    fi
  fi
  exit 0
fi

# --- SubagentStop: notify only if subagent was background --------------------
if [[ "$EVENT" == "SubagentStop" ]]; then
  BG_FILE="${STATE_DIR}/bg_task_${KEY}"

  if [[ -f "$BG_FILE" ]]; then
    DESC=$(cat "$BG_FILE")
    rm -f "$BG_FILE"
    SHORT=$(short_str "$DESC" 50)
    set_window_state done-bg
    # A terminal state, not `working`: if the main agent is still going its next
    # tool call flips it back, whereas a stale `working` would sit until session
    # end. Its own state rather than plain `done` so the menu bar can keep the
    # crystalBlue "a background task landed" colour distinct from a finished turn.
    write_state done-bg "bg done · ${SHORT}"
    notify "$(tmux_styled "$KW_BLUE" '' 'BG' "$SHORT")"
  fi
  exit 0
fi

# --- Stop / Notification: always notify --------------------------------------
case "$EVENT" in
  Stop)
    set_window_state done
    set_last_message
    write_state done "${LAST_MSG:-Claude finished}"
    notify "$(tmux_styled "$KW_GREEN" '' 'DONE' "finished in ${PROJECT}")"
    ;;
  Notification)
    set_window_state waiting
    set_last_message
    # A permission/approval notification says what is being waited on ("... permission
    # to use Bash"), so it beats the last assistant message. A generic "waiting for
    # your input" is the opposite: the real question is inside LAST_MSG.
    case "$MESSAGE" in
      *permission*|*approval*) detail="$MESSAGE" ;;
      *) detail="${LAST_MSG:-${MESSAGE:-needs input}}" ;;
    esac
    write_state waiting "$detail"
    notify "$(tmux_styled "$KW_ORANGE" '󰛐' 'INPUT' "needs input in ${PROJECT}")"
    ;;
  *)
    write_state working "${EVENT}"
    notify "$(tmux_styled "$KW_WHITE" '󱜙' 'EVENT' "${EVENT} in ${PROJECT}")"
    ;;
esac

exit 0
