<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ersanisik.claude-menubar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ersanisik/.local/bin/claude-menubar</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd hands down a bare PATH; claude-jump needs brew's tmux. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- Without a UTF-8 locale tmux mangles its own output: emoji session names come
         back as "__ Main" and a tab in a format string turns into "_". -->
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/claude-menubar.err.log</string>
</dict>
</plist>
