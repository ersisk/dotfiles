<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ersanisik.ollama</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Ollama.app/Contents/Resources/ollama</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Not 11434: the rubberduck-ollama container publishes that port and, with an
         empty model store of its own, answers queries with {"models":[]}. ai-oneshot
         tries 11435 first, then falls back to 11434. -->
    <key>OLLAMA_HOST</key>
    <string>127.0.0.1:11435</string>
    <!-- Beekeeper Studio runs its plugin views on a scheme of its own, and plugin://
         is not in ollama's default origin list — AI Shell's preflight
         (OPTIONS /v1/models) was getting a 403. Only that scheme is opened: no web
         page can produce a plugin:// origin, so unlike opening "*" or "null" this
         creates no external access surface. -->
    <key>OLLAMA_ORIGINS</key>
    <string>plugin://*</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/ollama-serve.err.log</string>
</dict>
</plist>
